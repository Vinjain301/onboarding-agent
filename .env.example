OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free OpenRouter models are frequently rate-limited or retired. The models
# listed in CHAT_MODEL_FALLBACKS (comma-separated) are tried in order if
# CHAT_MODEL fails. Check current free models at
# https://openrouter.ai/models?max_price=0
CHAT_MODEL=minimax/minimax-m3:free
CHAT_MODEL_FALLBACKS=liquid/lfm-2.5-2.6b:free
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# See "Confidence threshold calibration" in ARCHITECTURE.md for how this
# default was derived.
CONFIDENCE_THRESHOLD=0.35
